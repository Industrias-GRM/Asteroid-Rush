{
  "manifest_version": 3,
  "name": "Asteroid Rush",
  "description": "Esquiva meteoritos, recoge power-ups y compite por el récord mundial.",
  "version": "1.0",
  "default_locale": "es",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://firestore.googleapis.com/v1/projects/asteroid-rush-odyssey/*",
    "https://firestore.googleapis.com/v1/projects/asteroid-rush-news/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.ttf",
        "images/*.png",
        "images/Asteroid Rush Skins/*.png",
        "sounds/*.mp3",
        "_locales/*/messages.json",
        "js/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}

